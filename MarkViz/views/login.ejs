<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Sign in or create a MarkViz account to open the dashboard." />
  <title>MarkViz | Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/login.css" />
</head>

<body>
	<main class="auth-dialog" role="dialog" aria-labelledby="authTitle" aria-modal="true">
		<a class="brand" href="/"><span class="logo">M</span> MarkViz</a>
		<h1 id="authTitle">Welcome back</h1>
		<p class="subtitle" id="authSubtitle">Sign in to continue to your academic workspace.</p>

		<div class="mode-switch" role="tablist" aria-label="Account access">
			<button class="active" id="loginTab" type="button" role="tab" aria-selected="true">Log in</button>
			<button id="signupTab" type="button" role="tab" aria-selected="false">Sign up</button>
		</div>

		<form id="authForm" novalidate>
			<label class="field signup-only" hidden>
				<span>Full name</span>
				<input id="fullName" name="fullName" type="text" autocomplete="name" placeholder="Your full name" />
			</label>
			<label class="field signup-only" hidden>
				<span>Teaching school name</span>
				<input id="schoolName" name="schoolName" type="text" autocomplete="organization" placeholder="Your school's name" />
			</label>
			<label class="field signup-only" hidden>
				<span>School address</span>
				<input id="schoolAddress" name="schoolAddress" type="text" autocomplete="street-address" placeholder="School address" />
			</label>
			<label class="field signup-only" hidden>
				<span>Username</span>
				<input id="username" name="username" type="text" autocomplete="username" placeholder="Choose a username" minlength="1" />
			</label>
			<label class="field signup-only" hidden>
				<span>Phone number</span>
				<input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="Your phone number" minlength="7" />
			</label>
			<label class="field">
				<span>Email address</span>
				<input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
			</label>
			<label class="field">
				<span>Password</span>
				<div class="password-control">
					<input id="password" name="password" type="password" autocomplete="current-password" placeholder="Your password" minlength="6" required />
					<button class="password-toggle" type="button" data-password-target="password" aria-label="Show password">Show</button>
				</div>
			</label>
			<a class="recovery-link" id="forgotPassword" href="#">Forgot password?</a>
			<label class="field signup-only" id="confirmField" hidden>
				<span>Confirm password</span>
				<div class="password-control">
					<input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="6" />
					<button class="password-toggle" type="button" data-password-target="confirmPassword" aria-label="Show confirm password">Show</button>
				</div>
			</label>
			<div class="field signup-only" id="captchaField" hidden>
				<span>Captcha</span>
				<div class="captcha-row">
					<strong class="captcha-code" id="captchaCode" aria-label="Generated captcha"></strong>
					<input id="captchaInput" name="captchaInput" type="text" autocomplete="off" placeholder="Enter code" />
					<button class="refresh-captcha" id="refreshCaptcha" type="button" aria-label="Generate a new captcha" title="Generate a new captcha">↻</button>
				</div>
			</div>
			<button class="submit" id="submitButton" type="submit">Log in to MarkViz</button>
			<p class="message" id="message" role="alert" aria-live="polite"></p>
		</form>
		<form id="recoveryForm" novalidate hidden>
			<p class="recovery-note" id="recoveryNote">Enter the username and phone number used during signup to verify your account.</p>
			<div id="identityFields" class="recovery-fields">
			<label class="field">
				<span>Username</span>
				<input id="recoveryUsername" type="text" autocomplete="username" placeholder="Your username" required />
			</label>
			<label class="field">
				<span>Phone number</span>
				<input id="recoveryPhone" type="tel" autocomplete="tel" inputmode="tel" placeholder="Your signup phone number" required />
			</label>
			</div>
			<div id="newPasswordFields" class="recovery-fields" hidden>
				<label class="field">
					<span>New password</span>
					<div class="password-control">
						<input id="newPassword" type="password" autocomplete="new-password" placeholder="Create a new password" minlength="6" />
						<button class="password-toggle" type="button" data-password-target="newPassword" aria-label="Show new password">Show</button>
					</div>
				</label>
				<label class="field">
					<span>Confirm new password</span>
					<div class="password-control">
						<input id="newPasswordConfirm" type="password" autocomplete="new-password" placeholder="Repeat your new password" minlength="6" />
						<button class="password-toggle" type="button" data-password-target="newPasswordConfirm" aria-label="Show confirm new password">Show</button>
					</div>
				</label>
			</div>
			<button class="submit" id="recoveryButton" type="submit">Verify details</button>
			<button class="submit" id="savePasswordButton" type="button" hidden>Save new password</button>
			<p class="message" id="recoveryMessage" role="alert" aria-live="polite"></p>
			<a class="back-link" id="backToLogin" href="#">Back to login</a>
		</form>
		<a class="back-link" id="closeAuth" href="/">Close</a>
	</main>

  <script src="/js/login.js"></script>
</body>
</html>
